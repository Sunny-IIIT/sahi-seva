generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// STATUS ENUMERATIONS
// ─────────────────────────────────────────────────────────────────────────────

// ═════════════════════════════════════════════════════════════════════════════
//  COOPERATIVE ADMINISTRATION
// ═════════════════════════════════════════════════════════════════════════════

model Federation {
  id          String    @id @default(cuid())
  name        String
  state       String
  district    String
  regNumber   String    @unique
  contactEmail String?
  contactPhone String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  societies   Society[]

  @@index([state, district])
}

model Society {
  id            String    @id @default(cuid())
  name          String
  pinCode       String
  address       String?
  federationId  String
  adminPhone    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  federation    Federation @relation(fields: [federationId], references: [id])
  workers       Worker[]

  @@index([federationId])
  @@index([pinCode])
}

// ═════════════════════════════════════════════════════════════════════════════
//  SERVICE CATEGORY
// ═════════════════════════════════════════════════════════════════════════════

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  baseRate    Int      // Fixed: Now Int (stored in paise/cents)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workers     Worker[]
}

// ═════════════════════════════════════════════════════════════════════════════
//  WORKER
// ═════════════════════════════════════════════════════════════════════════════

model Worker {
  id            String    @id @default(cuid())

  name          String
  phone         String    @unique
  area          String?
  priceRate     String?
  trustScore    Int       @default(80)
  isProfilePublic Boolean  @default(true)
  
  // Fixed: Added @unique constraint to prevent identity fraud
  aadhaarToken  String?   @unique
  
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  jobsDone      Int       @default(0)
  avgRating     Float     @default(0.0) // This stays float for rating

  societyId     String?
  society       Society?  @relation(fields: [societyId], references: [id])

  category      String
  categoryId    String?
  serviceCategory ServiceCategory? @relation(fields: [categoryId], references: [id])

  certificationType String  @default("NONE")
  isGovtCertified   Boolean @default(false)
  certificationUrl  String?

  latitude      Float?    // Stays float for geo coords
  longitude     Float?
  isOnline      Boolean   @default(false)

  insuranceStatus          String  @default("NONE")
  insuranceExpiry          DateTime?
  
  // Fixed: Financials changed to Int (paise)
  welfareFundContribution  Int     @default(0)
  totalEarnings            Int     @default(0)

  bookings      Booking[]
  reviews       Review[]
  tickets       Ticket[]

  @@index([status, isProfilePublic])
  @@index([status, category])
  @@index([trustScore(sort: Desc)])
  @@index([societyId])
  @@index([categoryId])
  @@index([latitude, longitude])
  @@index([isGovtCertified])
}

// ═════════════════════════════════════════════════════════════════════════════
//  CUSTOMER
// ═════════════════════════════════════════════════════════════════════════════

model Customer {
  id              String    @id @default(cuid())
  name            String?
  phone           String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  trustPassExpiry DateTime?

  latitude        Float?
  longitude       Float?

  bookings        Booking[]
  tickets         Ticket[]
}

// ═════════════════════════════════════════════════════════════════════════════
//  BOOKING
// ═════════════════════════════════════════════════════════════════════════════

model Booking {
  id          String   @id @default(cuid())
  customerId  String
  workerId    String
  status      String   @default("PENDING")
  
  // Fixed: Changed to Int
  amount      Int?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  scheduledAt DateTime?

  isEmergency Boolean  @default(false)
  serviceOtp  String?
  startedAt   DateTime?

  pinCode     String?
  latitude    Float?
  longitude   Float?

  customer    Customer  @relation(fields: [customerId], references: [id])
  worker      Worker    @relation(fields: [workerId], references: [id])
  invoice     Invoice?
  review      Review?
  tickets     Ticket[]
  transaction Transaction?

  @@index([customerId])
  @@index([workerId])
  @@index([status])
  @@index([pinCode])
  @@index([isEmergency])
  @@index([createdAt])
}

// ═════════════════════════════════════════════════════════════════════════════
//  INVOICE
// ═════════════════════════════════════════════════════════════════════════════

model Invoice {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  invoiceNumber   String   @unique @default(cuid())
  
  // Fixed: All financials to Int
  subtotal        Int
  platformFee     Int      @default(0)
  welfareFeeDeducted Int   @default(0)
  gst             Int      @default(0)
  totalAmount     Int
  
  paidAt          DateTime?
  paymentMethod   String?
  paymentRef      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  booking         Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

// ═════════════════════════════════════════════════════════════════════════════
//  TRANSACTION
// ═════════════════════════════════════════════════════════════════════════════

model Transaction {
  id               String   @id @default(cuid())
  bookingId        String   @unique
  
  // Fixed: All financials to Int
  totalAmount      Int
  workerShare      Int    
  societyFundShare Int    
  
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  booking          Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([status])
}

// ═════════════════════════════════════════════════════════════════════════════
//  TICKET
// ═════════════════════════════════════════════════════════════════════════════

model Ticket {
  id          String   @id @default(cuid())
  bookingId   String
  customerId  String?
  workerId    String?
  subject     String
  description String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking     Booking   @relation(fields: [bookingId], references: [id])
  customer    Customer? @relation(fields: [customerId], references: [id])
  worker      Worker?   @relation(fields: [workerId], references: [id])

  @@index([bookingId])
  @@index([customerId])
  @@index([workerId])
  @@index([status])
}

// ═════════════════════════════════════════════════════════════════════════════
//  REVIEW
// ═════════════════════════════════════════════════════════════════════════════

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  workerId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  booking   Booking  @relation(fields: [bookingId], references: [id])
  worker    Worker   @relation(fields: [workerId], references: [id])

  @@index([workerId])
  @@index([rating])
}

// ═════════════════════════════════════════════════════════════════════════════
//  VERIFICATION TOKEN
// ═════════════════════════════════════════════════════════════════════════════

model VerificationToken {
  id        String   @id @default(cuid())
  phone     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([phone, otp], name: "phone_otp")
  @@index([phone])
}
